# Copie para .env.local e preencha. Nada aqui é segredo: variáveis NEXT_PUBLIC_
# vão para o navegador de quem visita. Senhas e chaves privadas NUNCA entram aqui.

# Endereço público do site (usado nos links da apresentação e nas metatags).
# Ex.: https://brupater.web.app ou o domínio próprio quando existir.
NEXT_PUBLIC_SITE_URL=

# De onde vêm as imagens que estão em caminhos como "assets/obras/x.webp".
# Vazio = do próprio site (pasta public/). Quando as imagens forem para o
# Firebase Storage (ou outro lugar), coloque aqui a URL base, sem barra no fim.
NEXT_PUBLIC_IMAGENS_URL=
